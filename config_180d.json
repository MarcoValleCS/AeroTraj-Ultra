{
  "project_name": "AeroTraj-Ultra (FlightBERT++ V3) - 180-day GPU run, 180s horizon",
  "seed": 97,
  "data": {
    "source": "pyopensky (s3.opensky-network.org/competition-data + Trino/REST compatible)",
    "data_dir": "./data180",
    "start_date": "2022-01-01",
    "num_total_days": 180,
    "train_days": 144,
    "val_days": 18,
    "test_days": 18,
    "row_groups_per_day": 12,
    "dt_seconds": 5,
    "min_segment_steps": 140,
    "window_stride_train": 8,
    "window_stride_eval": 12,
    "region_bounds": {
      "lon_min": -15.0,
      "lon_max": 35.0,
      "lat_min": 30.0,
      "lat_max": 65.0,
      "alt_min_ft": -500.0,
      "alt_max_ft": 50000.0
    }
  },
  "window": {
    "inp_seq_len": 12,
    "horizon": 12,
    "horizon_steps_5s": [1, 2, 3, 4, 6, 9, 12, 15, 18, 24, 30, 36],
    "horizon_seconds": [5, 10, 15, 20, 30, 45, 60, 75, 90, 120, 150, 180]
  },
  "graycode": {
    "use_graycode": true,
    "lon_size": 19,
    "lat_size": 18,
    "alt_size": 12,
    "spdx_size": 12,
    "spdy_size": 12,
    "spdz_size": 12,
    "delta_lon_size": 10,
    "delta_lat_size": 10,
    "delta_alt_size": 9,
    "delta_spdx_size": 9,
    "delta_spdy_size": 9,
    "delta_spdz_size": 8,
    "delta_lon_scale": 10000.0,
    "delta_lat_scale": 10000.0,
    "delta_alt_scale": 10.0,
    "delta_spd_scale": 2.0
  },
  "model": {
    "attr_embed_dim": 24,
    "n_embd": 144,
    "n_head": 6,
    "n_en_layer": 2,
    "n_de_layer": 2,
    "dropout": 0.1
  },
  "training": {
    "batch_size": 4096,
    "epochs": 80,
    "max_train_samples_per_epoch": 600000,
    "max_val_samples": 60000,
    "max_test_samples": 200000,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "optimizer": "adamw",
    "scheduler": "onecycle",
    "early_stopping": {
      "enabled": true,
      "patience": 15,
      "min_delta": 1.0,
      "min_epochs": 30
    },
    "bce_weight": 0.4,
    "gc_ste_weight": 0.25,
    "cont_weight": 2.5,
    "vel_weight": 0.6,
    "physics_weight": 0.25,
    "baseline_max_samples_per_epoch": 400000,
    "baseline_epochs": 10,
    "num_workers": 6,
    "save_dir": "./checkpoints180",
    "results_dir": "./results180"
  }
}
