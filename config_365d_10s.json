{
  "project_name": "AeroTraj-Ultra - 365 days, dt=10s, 12-point window (120 s of history), horizons 10/30/60/90/180/300 s",
  "seed": 97,
  "data": {
    "source": "pyopensky (s3.opensky-network.org/competition-data + Trino/REST compatible)",
    "data_dir": "./data365_10s",
    "start_date": "2022-01-01",
    "num_total_days": 365,
    "train_days": 293,
    "val_days": 36,
    "test_days": 36,
    "row_groups_per_day": 12,
    "dt_seconds": 10,
    "min_segment_steps": 70,
    "window_stride_train": 4,
    "window_stride_eval": 6,
    "region_bounds": {
      "lon_min": -15.0,
      "lon_max": 35.0,
      "lat_min": 30.0,
      "lat_max": 65.0,
      "alt_min_ft": -500.0,
      "alt_max_ft": 50000.0
    }
  },
  "window": {
    "inp_seq_len": 12,
    "horizon": 6,
    "horizon_steps": [
      1,
      3,
      6,
      9,
      18,
      30
    ],
    "horizon_seconds": [
      10,
      30,
      60,
      90,
      180,
      300
    ]
  },
  "graycode": {
    "use_graycode": true,
    "lon_size": 19,
    "lat_size": 18,
    "alt_size": 12,
    "spdx_size": 12,
    "spdy_size": 12,
    "spdz_size": 12,
    "delta_lon_size": 11,
    "delta_lat_size": 11,
    "delta_alt_size": 9,
    "delta_spdx_size": 9,
    "delta_spdy_size": 9,
    "delta_spdz_size": 8,
    "delta_lon_scale": 10000.0,
    "delta_lat_scale": 10000.0,
    "delta_alt_scale": 10.0,
    "delta_spd_scale": 2.0
  },
  "model": {
    "attr_embed_dim": 24,
    "n_embd": 144,
    "n_head": 6,
    "n_en_layer": 2,
    "n_de_layer": 2,
    "dropout": 0.1
  },
  "training": {
    "batch_size": 2048,
    "epochs": 150,
    "max_train_samples_per_epoch": 1200000,
    "max_val_samples": 30000,
    "max_test_samples": 60000,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "bce_weight": 0.4,
    "gc_ste_weight": 0.25,
    "cont_weight": 2.5,
    "vel_weight": 0.6,
    "physics_weight": 0.25,
    "baseline_max_samples_per_epoch": 400000,
    "baseline_epochs": 6,
    "num_workers": 6,
    "save_dir": "./checkpoints_365_10s",
    "results_dir": "./results_365_10s",
    "early_stopping": {
      "enabled": true,
      "patience": 20,
      "min_delta": 0.5,
      "min_epochs": 40
    }
  }
}
