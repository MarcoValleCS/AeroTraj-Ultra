# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/

# --- project artefacts (regenerable) -----------------------------------------
# Datasets: rebuilt from OpenSky with `python data_pipeline.py --config <cfg>`
#   data/  data90/  data180/  data*/_cache_days/
data/
data90/
data180/
data*/
!data*/.gitkeep

# Trained weights
checkpoints/
checkpoints40gpu/
checkpoints90/
checkpoints90_180s/
checkpoints180/
checkpoints_bench/
checkpoints_bench_timing/
checkpoints*/
!checkpoints*/.gitkeep

# Results: the small TEXT artefacts (markdown / json / csv, ~1.4 MB) are published
# as reproducibility evidence; the heavy figures (png, ~9 MB) are regenerated by
# the runs and stay out of the repository.
# NB: do NOT ignore the directories themselves - git cannot re-include a file
# whose parent directory is excluded.
results*/*.png
results*/*.pdf
results*/*/*.png
results*/*/*/*.png

# --- unrelated ----------------------------------------------------------------
job-search/

# --- editors / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

